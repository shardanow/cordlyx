# --- Local dev (docker-compose.yml + dev.sh / npm) ---
# Database
DATABASE_URL=postgres://cordlyx:cordlyx@localhost:5432/cordlyx

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (min 32 chars — generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-secret-min-32-chars-xxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=4000
NODE_ENV=development

# Frontend (dev)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Admin (comma-separated emails)
ADMIN_EMAILS=admin@example.com

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# --- Production only (docker-compose.prod.yml) ---
# POSTGRES_PASSWORD=cordlyx          # default keeps dev/CI compat; set a strong one in prod
# CORS_ORIGIN=                       # same-origin via nginx by default; set only for direct API access
# JWT_SECRET is REQUIRED in prod (compose fails fast if missing)
